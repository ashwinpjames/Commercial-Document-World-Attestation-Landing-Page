Options -Indexes
RewriteEngine On
RewriteBase /commercial-document-attestation/

# Force HTTPS only for this landing-page directory.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Allow the PHP enquiry endpoint.
RewriteRule ^api/contact\.php$ - [L]

# Serve existing files and prerendered directories as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Do not route unknown URLs into the WordPress site.
RewriteRule ^ - [R=404,L]
ErrorDocument 404 /commercial-document-attestation/404.html

<IfModule mod_brotli.c>
 AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
 ExpiresActive On
 ExpiresByType image/webp "access plus 1 year"
 ExpiresByType image/avif "access plus 1 year"
 ExpiresByType image/svg+xml "access plus 1 year"
 ExpiresByType text/css "access plus 1 year"
 ExpiresByType application/javascript "access plus 1 year"
 ExpiresByType font/woff2 "access plus 1 year"
 ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
 <FilesMatch "\.(js|css|webp|avif|svg|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
 </FilesMatch>
 <FilesMatch "\.html$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
 </FilesMatch>
 Header always set X-Content-Type-Options "nosniff"
 Header always set X-Frame-Options "SAMEORIGIN"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
